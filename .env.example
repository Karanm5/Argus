# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional overrides ────────────────────────────────────────────────
CHROMA_PATH=./data/chroma
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENV=dev                    # Set to "prod" to disable auto-reload

# ── Uncertainty tuning ────────────────────────────────────────────────
# Increase N_SAMPLES for higher-fidelity uncertainty estimates (more API calls)
# ARGUS_N_SAMPLES=5
# ARGUS_UNCERTAINTY_THRESHOLD=0.65
